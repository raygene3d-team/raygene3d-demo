{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug raygene3d-demo",
      "request": "launch",
      "program": "${command:cmake.launchTargetPath}",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "windows": {
        "type": "cppvsdbg",
        "console": "integratedTerminal"
      },
      "linux": {
        "type": "cppdbg",
        "MIMode": "gdb",
        "externalConsole": false,
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ]
      },
      "osx": {
        "type": "lldb"
      }
    }
  ]
}
