{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug raygene3d-demo",
      "request": "launch",
      "program": "${workspaceFolder}/bin/raygene3d-demo",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}",
      "preLaunchTask": "build raygene3d-demo (Debug)",
      "windows": {
        "type": "cppvsdbg",
        "program": "${workspaceFolder}/bin/raygene3d-demo.exe",
        "console": "integratedTerminal"
      },
      "linux": {
        "type": "cppdbg",
        "MIMode": "gdb",
        "externalConsole": false,
        "setupCommands": [
          {
            "description": "Enable pretty-printing for gdb",
            "text": "-enable-pretty-printing",
            "ignoreFailures": true
          }
        ]
      },
      "osx": {
        "type": "cppdbg",
        "MIMode": "lldb",
        "externalConsole": false,
        "miDebuggerPath": "${env:HOME}/.vscode/extensions/ms-vscode.cpptools-1.35.6-darwin-arm64/debugAdapters/lldb-mi/bin/lldb-mi"
      }
    }
  ]
}

